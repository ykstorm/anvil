#cloud-config
package_update: true
packages:
  - git
  - curl
  - gnupg

write_files:
  # REDIS_URL and PORT only. WEBHOOK_SECRET is deliberately NOT written here:
  # cloud-init user_data is readable from the instance metadata service and the
  # provider console, so a secret placed in it would be exposed. After the VM
  # boots, provision the secret out of band, for example:
  #   ssh root@<server> 'echo WEBHOOK_SECRET=whsec_... >> /etc/anvil/server.env \
  #     && systemctl restart anvil-server'
  # The unit stays in a restart loop until the secret is present.
  # REDIS_URL below has no password for the same reason; the operator adds it
  # after boot (see the module README).
  - path: /etc/anvil/server.env
    permissions: "0600"
    content: |
      REDIS_URL=${redis_url}
      PORT=${port}

  - path: /etc/systemd/system/anvil-server.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Anvil webhook server
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=simple
      EnvironmentFile=/etc/anvil/server.env
      WorkingDirectory=/opt/anvil
      ExecStart=/usr/bin/node /opt/anvil/apps/server/dist/index.js
      Restart=always
      RestartSec=3
      User=anvil
      Group=anvil

      [Install]
      WantedBy=multi-user.target

runcmd:
  # Node 20 from NodeSource via a signed apt repo (keyring), not curl | bash.
  - install -d -m 0755 /etc/apt/keyrings
  - curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg
  - echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" > /etc/apt/sources.list.d/nodesource.list
  - apt-get update
  - apt-get install -y nodejs
  - npm install -g pnpm@9
  - useradd --system --create-home --shell /usr/sbin/nologin anvil || true
  - git clone https://github.com/ykstorm/anvil.git /opt/anvil
  - git -C /opt/anvil checkout ${git_ref}
  - bash -lc 'cd /opt/anvil && pnpm install --frozen-lockfile && pnpm -r build'
  - chown -R anvil:anvil /opt/anvil
  - systemctl daemon-reload
  - systemctl enable --now anvil-server
